# Public site origin for SEO (canonical, Open Graph, Twitter, sitemap).
# No trailing slash. Used at build time by Vite (and Docker/Compose builds).
#
# Copy to .env.production (or .env) and set your real domain:
#   cp .env.example .env.production
#
# Or pass inline:
#   VITE_SITE_ORIGIN=https://your-domain.com npm run build
#   VITE_SITE_ORIGIN=https://your-domain.com docker compose up --build

VITE_SITE_ORIGIN=https://your-domain.com

# Host port for docker compose (container still listens on 80)
# PORT=8080
